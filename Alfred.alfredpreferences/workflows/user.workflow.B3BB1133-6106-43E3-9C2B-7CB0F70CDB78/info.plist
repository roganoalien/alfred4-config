				<string>#!/usr/bin/env python3
import os
import json

alphabet = [
    ("A", "Alpha", "icons/a.png"), ("B", "Bravo", "icons/b.png"), ("C", "Charlie", "icons/c.png"),
    ("D", "Delta", "icons/d.png"), ("E", "Echo", "icons/e.png"), ("F", "Foxtrot", "icons/f.png"),
    ("G", "Golf", "icons/g.png"), ("H", "Hotel", "icons/h.png"), ("I", "India", "icons/i.png"),
    ("J", "Juliett", "icons/j.png"), ("K", "Kilo", "icons/k.png"), ("L", "Lima", "icons/l.png"),
    ("M", "Mike", "icons/m.png"), ("N", "November", "icons/n.png"), ("O", "Oscar", "icons/o.png"),
    ("P", "Papa", "icons/p.png"), ("Q", "Quebec", "icons/q.png"), ("R", "Romeo", "icons/r.png"),
    ("S", "Sierra", "icons/s.png"), ("T", "Tango", "icons/t.png"), ("U", "Uniform", "icons/u.png"),
    ("V", "Victor", "icons/v.png"), ("W", "Whiskey", "icons/w.png"), ("X", "X-ray", "icons/x.png"),
    ("Y", "Yankee", "icons/y.png"), ("Z", "Zulu", "icons/z.png")
]

items = []
for letter, word, icon in alphabet:
    items.append({
        "title": f"{letter}",
        "subtitle": f"{word}",
        "arg": word,
        "icon": {
            "path": f"{icon}"
        }
    })

print(json.dumps({"items": items}))</string>
