				<string>#!/usr/bin/env python3
import sys
import json

# NATO Phonetic Alphabet mapping
nato = {
    "A": "Alpha", "B": "Bravo", "C": "Charlie", "D": "Delta", "E": "Echo",
    "F": "Foxtrot", "G": "Golf", "H": "Hotel", "I": "India", "J": "Juliett",
    "K": "Kilo", "L": "Lima", "M": "Mike", "N": "November", "O": "Oscar",
    "P": "Papa", "Q": "Quebec", "R": "Romeo", "S": "Sierra", "T": "Tango",
    "U": "Uniform", "V": "Victor", "W": "Whiskey", "X": "X-ray", "Y": "Yankee",
    "Z": "Zulu"
}

# Get the input query from Alfred
if len(sys.argv) &gt; 1:
    query = sys.argv[1]
else:
    query = ""

# Split query into words
words = query.strip().split()

# Convert each word to its phonetic equivalent
converted_words = []
for word in words:
    phonetic_letters = []
    for char in word.upper():
        if char in nato:
            phonetic_letters.append(nato[char])
        else:
            phonetic_letters.append(char)  # keep symbols/numbers
    converted_words.append("-".join(phonetic_letters))

# Join converted words back into a phrase
final_output = "---".join(converted_words)

print(final_output)</string>
